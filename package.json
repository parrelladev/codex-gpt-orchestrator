{
  "name": "codex-gpt-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "tsc",
    "start": "node dist/server/main.js",
    "mcp": "node dist/mcp/main.js",
    "setup": "node scripts/setup.mjs",
    "chrome": "node scripts/chrome.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "test": "vitest run",
    "test:chrome": "node scripts/test-chrome.mjs",
    "typecheck": "tsc --noEmit",
    "manual": "node scripts/manual.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "5.12.8",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  }
}
